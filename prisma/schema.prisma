// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum OrganizationType {
  COMPANY
  UNIVERSITY
  SCHOOL
  GOVERNMENT
  NGO
  COMMUNITY
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrganizationInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  isActive  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  organizationMembers  OrganizationMember[]
  organizationRequests OrganizationRequest[]
  organizationInvites  OrganizationInvite[]  @relation("OrganizationInvitesSent")
}

model EmailVerification {
  id           String    @id @default(cuid())
  email        String
  codeHash     String
  expiresAt    DateTime
  attempts     Int       @default(0)
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
}

model Organization {
  id                     String             @id @default(cuid())
  name                   String
  slug                   String             @unique
  description            String?
  logoUrl                String?
  type                   OrganizationType
  status                 OrganizationStatus @default(ACTIVE)
  affiliatedOrganization String?
  website                String?
  country                String?
  region                 String?
  city                   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
  invites OrganizationInvite[]
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole @default(MEMBER)

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationRequest {
  id     String @id @default(cuid())
  userId String

  name                   String
  description            String?
  logoUrl                String?
  type                   OrganizationType
  affiliatedOrganization String?
  website                String?
  country                String?
  region                 String?
  city                   String?
  reason                 String?

  status OrganizationRequestStatus @default(PENDING)

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model OrganizationInvite {
  id             String @id @default(cuid())
  organizationId String
  invitedById    String

  email  String
  role   OrganizationMemberRole   @default(MEMBER)
  token  String                   @unique
  status OrganizationInviteStatus @default(PENDING)

  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("OrganizationInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
}
